{
  "name": "@beyond10x/website",
  "version": "0.3.2",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "node scripts/preview.mjs dev",
    "dev": "node scripts/preview.mjs dev",
    "dev:fast": "node scripts/preview.mjs dev-fast",
    "preview:build": "node scripts/preview.mjs build",
    "prepare:site": "node scripts/prepare-site.mjs",
    "sources:collect": "node scripts/collect-sources.mjs",
    "sources:lock": "node scripts/update-source-lock.mjs",
    "sources:freshness": "node scripts/update-source-lock.mjs --check",
    "sources:lock:check": "npm run sources:freshness",
    "routes:capture": "node scripts/capture-legacy-routes.mjs",
    "redirect:build": "node scripts/build-redirect-facade.mjs",
    "build:site": "node scripts/generation-command.mjs build-site",
    "redirects:root": "node scripts/write-root-redirects.mjs",
    "verify:navigation": "node scripts/verify-navigation.mjs",
    "audit:navigation-layout": "node scripts/verify-navigation-layout.mjs",
    "index:search": "node scripts/verify-pagefind-input.mjs && pagefind --site build --output-subdir pagefind --exclude-selectors '.theme-doc-breadcrumbs,.theme-doc-toc-mobile,.pagination-nav'",
    "verify:search": "node --no-warnings scripts/verify-search.mjs",
    "redirects:effective": "node scripts/write-effective-redirects.mjs",
    "crawl": "node scripts/crawl-build.mjs",
    "build": "node scripts/generation-command.mjs build",
    "clear": "node scripts/generation-command.mjs clear",
    "serve": "docusaurus serve",
    "typecheck": "tsc",
    "test": "node --test tests/*.test.mjs",
    "sources:verify": "node scripts/verify-source-lock.mjs",
    "bootstrap:verify": "node scripts/verify-bootstrap.mjs",
    "validate:experiences": "node scripts/validate-experiences.mjs",
    "audit:code-rendering": "node scripts/code-contract.mjs source && node scripts/code-contract.mjs build",
    "gate": "node scripts/run-gate.mjs",
    "gate:fixture": "B10X_BOOTSTRAP_FIXTURE=1 node scripts/run-gate.mjs"
  },
  "dependencies": {
    "@beyond10x/docs-system": "git+https://github.com/beyond10x/docs-system.git#1ef1890272ce308eb6fec5446091f93afd14046f",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "parse5": "7.3.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "^19.0.0",
    "pagefind": "1.5.2",
    "typescript": "~6.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=24.0"
  }
}
